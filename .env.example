# APP_URL: The public URL where this app is hosted.
# Used for self-referential links and generated admin/viewer URLs.
APP_URL="YOUR_APP_URL"

# Supabase values used by the backend service.
# Set these in Vercel as project environment variables.
SUPABASE_URL="YOUR_SUPABASE_URL"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"

# Optional values for admin session management.
# Use a secure random value in production.
ADMIN_SESSION_SECRET="YOUR_ADMIN_SESSION_SECRET"
LOCAL_ADMIN_ACCESS_TOKEN="local-admin-token"
